{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"],
  /*
   * `vite.config.ts` / `tailwind.config.ts` are Node-side build tooling and live
   * in their own project (see `tsconfig.node.json`): that is where `types:
   * ["node"]` comes from, and referencing it means `tsc -b` checks the config
   * files as well as `src`.
   */
  "references": [{ "path": "./tsconfig.node.json" }]
}
