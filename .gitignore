# ---- Flutter / Dart (mobile/) ----
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.packages
mobile/build/
mobile/.pub-cache/
mobile/.pub/
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/**/gradle-wrapper.jar
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/ios/Flutter/Flutter.framework
# Generated on every `flutter pub get`/build from the *local* Flutter SDK. They
# carry this machine's absolute paths (and a `FLUTTER_ROOT` that is meaningless
# anywhere else), so a committed copy is stale on every other checkout: Xcode
# reads a Windows path, and `git status` is dirty for every developer.
# `mobile/ios/.gitignore` already lists the same three patterns; they are repeated
# here so the rule is visible from the repo root, where the tracked copies were
# removed with `git rm --cached` - no .gitignore rule ever hides a *tracked* file.
mobile/ios/Flutter/Generated.xcconfig
mobile/ios/Flutter/flutter_export_environment.sh
mobile/ios/Flutter/ephemeral/
mobile/*.iml

# ---- Release signing material (mobile/android/) ----
# The keystore *and* the file that unlocks it. Leaking either lets anyone publish an
# "upgrade" of this app - camera permission, kiosk pin and all - that the school's
# students would install. `key.properties.example` is the committed template.
mobile/android/key.properties
*.jks
*.keystore

# ---- Deno type-checking (supabase/functions/) ----
# Dev-only: `@types/deno`, `typescript`, and the npm packages the `npm:`
# specifiers name — what the editor and `npm run typecheck` read. `supabase
# functions deploy` bundles only what a function imports, so none of it ships.
supabase/functions/node_modules/

# ---- Kotlin/Gradle build state (mobile/android/) ----
mobile/android/.kotlin/

# ---- Editor / OS ----
.vscode/
.idea/
.DS_Store
*.swp
.env*
supabase/.temp/
supabase\.temp/